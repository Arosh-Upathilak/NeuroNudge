# Environment Variables
# Purpose:
# - Documents all required environment variables for the project.
# - Helps developers understand which variables are needed.
# - Should contain only example or dummy values.
# - Never store secrets or production credentials in this file.

PORT=5000
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

DATABASE_URL=DATABASE_URL

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----"