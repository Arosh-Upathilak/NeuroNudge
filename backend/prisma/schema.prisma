generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id
  email         String          @unique
  name          String?
  isVerified    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  messages      Message[]
  memories      Memory[]
  noiseSettings NoiseSetting[]
  notifications Notification[]
  searchHistory SearchHistory[]
}

model Memory {
  memoryId String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  createdAt DateTime @default(now())

  location Location?
  image    Image?

  @@index([userId, createdAt(sort: Desc)])
  @@map("memory")
}

model Location {
  id        String @id @default(uuid())
  latitude  Float
  longitude Float

  memoryId String @unique
  memory   Memory @relation(fields: [memoryId], references: [memoryId], onDelete: Cascade)

  @@map("location")
}

model Image {
  id       String  @id @default(uuid())
  imageUrl String
  publicId String?

  memoryId String @unique
  memory   Memory @relation(fields: [memoryId], references: [memoryId], onDelete: Cascade)

  @@map("image")
}

model Message {
  messageId String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role MessageRole

  content   String  @db.Text
  aiContent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("message")
}

enum MessageRole {
  user
  assistant
}

enum Action {
  created
  retrieved
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String
  read  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
}

model NoiseSetting {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive    Boolean @default(true)
  threshold   Float   @default(65.0)
  audioSource String? @default("sea-breeze")
  ancEnabled  Boolean @default(true)

  @@index([userId])
}

model SearchHistory {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query     String
  createdAt DateTime @default(now())

  @@index([userId])
}
